# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/assessment_portal
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/assessment_portal
MONGODB_URI=mongodb://localhost:27017/assessment_portal

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# ─── Admin seed (first super admin) ──────────────────────────────────────────
ADMIN_EMAIL=admin@assessment.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# localhost:5173 is always allowed in development.
# Example (multiple): https://your-app.vercel.app,https://your-app.onrender.com
CLIENT_URL=http://localhost:5173

# ─── Code Execution ───────────────────────────────────────────────────────────
# Execution timeout in milliseconds (default: 10 seconds)
CODE_EXEC_TIMEOUT=10000

# Memory limit per execution in MB (default: 256 MB)
MAX_MEMORY_MB=256



# ─── Email (optional — for result notification emails) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Assessment Portal <noreply@assessment.com>
