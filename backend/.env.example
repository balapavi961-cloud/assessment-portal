# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/assessment_portal

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Admin seed (first super admin)
ADMIN_EMAIL=admin@assessment.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin

# Email (optional - for result notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Assessment Portal <noreply@assessment.com>

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Code execution timeout (ms)
CODE_EXEC_TIMEOUT=10000
